# 复制为 .env 并按环境修改。所有配置均可用环境变量覆盖。

# --- 运行时 ---
DEVICE=auto                # auto | cpu | cuda | mps
FP16=true                  # 仅在 CUDA 生效；mps/cpu 自动降为 fp32
LOG_LEVEL=INFO
# API_KEY 留空则不鉴权；设置后请求须带 Authorization: Bearer <key>
# 注意：空值行不能写行内注释——python-dotenv 会把 "# ..." 整个当成值
API_KEY=
CORS_ORIGINS=*

# --- 引擎 ---
TTS_ENGINE=cosyvoice2      # 可选引擎: cosyvoice2
STT_ENGINE=sensevoice      # 可选引擎: sensevoice
PRELOAD_ENGINES=true       # 生产 true（后台预加载）；开发调试可设 false（首请求懒加载）
LOAD_TIMEOUT_S=300

# --- 模型 ---
MODEL_DIR=models           # 权重缓存目录（gitignore）
MODEL_SOURCE=modelscope    # modelscope | hf
# HF_ENDPOINT 例如 https://hf-mirror.com
HF_ENDPOINT=
# DEFAULT_VOICE 留空用引擎默认音色
DEFAULT_VOICE=

# --- 限额 ---
MAX_TEXT_CHARS=5000        # 单次 TTS 最大字符数
TTS_CHUNK_CHARS=800        # 长文本自动分块阈值
MAX_AUDIO_SECONDS=600      # 单次 STT 最大音频时长
MAX_AUDIO_BYTES=52428800   # 单次 STT 最大文件字节数（50MB）
ALLOW_ZERO_SHOT=false      # 是否开放 zero-shot 声音克隆

# --- 并发 ---
MAX_CONCURRENT_INFER=1     # GPU 信号量（8GB 双模型常驻务必为 1）
MAX_QUEUE=8                # 排队上限，超出返回 429
REQUEST_TIMEOUT_S=120      # 单请求推理超时，超时返回 504
